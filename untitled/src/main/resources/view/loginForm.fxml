<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: linear-gradient(to bottom, #f7f7f8, #eaeaea); -fx-padding: 20;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginFormController">
    <children>

        <Label layoutX="180.0" layoutY="40.0" text="Login" textFill="#333333">
            <font>
                <Font name="Segoe UI Bold" size="36.0" />
            </font>
        </Label>

        <TextField fx:id="txtUsername" layoutX="100.0" layoutY="130.0" prefHeight="45.0" prefWidth="300.0" promptText="Username" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cccccc; -fx-font-size: 14px;">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></TextField>

        <PasswordField fx:id="txtPassword" layoutX="100.0" layoutY="190.0" prefHeight="45.0" prefWidth="300.0" promptText="Password" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cccccc; -fx-font-size: 14px;" />

        <Button layoutX="170.0" layoutY="260.0" onAction="#btnLogin" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #10a37f; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 16px; -fx-font-weight: bold;" text="Login" />
    </children>
</AnchorPane>
