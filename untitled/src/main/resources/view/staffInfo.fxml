<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.StaffInfoController">
   <children>
      <AnchorPane layoutX="14.0" layoutY="5.0" prefHeight="560.0" prefWidth="883.0" style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);" stylesheets="@../Style/customer.css">
         <children>
            <VBox alignment="TOP_CENTER" spacing="15" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
               <children>
                  <Label text="Staff Information" textFill="#2b2d42">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER" prefHeight="65.0" prefWidth="706.0" spacing="15">
                     <children>
                        <VBox spacing="10">
                           <children>
                              <TextField fx:id="txtStaffId" prefWidth="160" promptText="Staff ID" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                              <TextField fx:id="txtPhone" prefWidth="160" promptText="Phone No" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                           </children>
                        </VBox>
                        <VBox spacing="10">
                           <children>
                              <TextField fx:id="txtName" prefWidth="240" promptText="Full Name" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                              <TextField fx:id="txtRole" prefHeight="27.0" prefWidth="141.0" promptText="Role" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                           </children>
                        </VBox>
                        <VBox spacing="10">
                           <children>
                              <TextField fx:id="txtAge" prefWidth="100" promptText="Age" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                              <TextField fx:id="txtEmail" promptText="Email" />
                              <TextField fx:id="txtSalary" promptText="Salary" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" spacing="20">
                     <children>
                        <Button onAction="#btnAdd" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8;" text="Add" />
                        <Button onAction="#btnUpdate" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 8;" text="Update" />
                        <Button onAction="#btnDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 8;" text="Delete" />
                        <Button onAction="#btnClear" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 8;" text="Clear" />
                     </children>
                  </HBox>
                  <TableView fx:id="staffTable" prefHeight="300" prefWidth="784.0" style="-fx-background-radius: 8; -fx-border-color: #dee2e6;">
                     <columns>
                        <TableColumn fx:id="ColumnStaffId" prefWidth="100" text="Staff ID" />
                        <TableColumn fx:id="ColumnName" prefWidth="139.19996643066406" text="Name" />
                        <TableColumn fx:id="ColumnPhoneNo" prefWidth="148.79998779296875" text="Phone No" />
                        <TableColumn fx:id="ColumnRole" prefWidth="128.0" text="Role" />
                        <TableColumn fx:id="ColumnEmail" prefWidth="147.199951171875" text="Email" />
                        <TableColumn fx:id="ColumnSalary" prefWidth="177.5999633789063" text="Salary" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
