<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);" stylesheets="@../Style/customer.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CustomerController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="15" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <!-- Header -->
            <Label text="Customer Information" textFill="#2b2d42">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>

            <!-- Input Fields -->
            <HBox alignment="CENTER" spacing="15">
                <VBox spacing="10">
                    <TextField fx:id="txtCustId" prefWidth="160" promptText="Customer ID" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                    <TextField fx:id="txtPhone" prefWidth="160" promptText="Phone No" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                </VBox>

                <VBox spacing="10">
                    <TextField fx:id="txtName" prefWidth="240" promptText="Full Name" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                    <TextField fx:id="txtCity" prefWidth="240" promptText="City" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                </VBox>

                <VBox spacing="10">
                    <TextField fx:id="txtAge" prefWidth="100" promptText="Age" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;" />
                </VBox>
            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#btnAdd" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8;" text="Add" />
                <Button onAction="#btnUpdate" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 8;" text="Update" />
                <Button onAction="#btnDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 8;" text="Delete" />
                <Button onAction="#btnClear" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 8;" text="Clear" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="custTable" prefHeight="300" prefWidth="720" style="-fx-background-radius: 8; -fx-border-color: #dee2e6;">
                <columns>
                    <TableColumn fx:id="ColumnCustId" prefWidth="100" text="Customer ID" />
                    <TableColumn fx:id="ColumnName" prefWidth="200" text="Name" />
                    <TableColumn fx:id="ColumnPhoneNo" prefWidth="150" text="Phone No" />
                    <TableColumn fx:id="ColumnCity" prefWidth="150" text="City" />
                    <TableColumn fx:id="ColumnAge" prefWidth="100" text="Age" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>

